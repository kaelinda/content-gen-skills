# Copy to .env for local tooling, or export these variables in the shell.
# The pipeline reads environment variables first and falls back to
# publishing-wechat-articles/config/runtime.local.toml.

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=kaelblog
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_PREFIX=wechat

FEISHU_MODE=lark-cli
FEISHU_PRIMARY_CHAT_ID=
FEISHU_TECH_APP_ID=
FEISHU_TECH_APP_SECRET=
FEISHU_PARENTING_APP_ID=
FEISHU_PARENTING_APP_SECRET=

FEISHU_TECH_CHAT_ID=
FEISHU_TECH_BASE_ID=
FEISHU_TECH_TABLE_ID=
FEISHU_PARENTING_CHAT_ID=
FEISHU_PARENTING_BASE_ID=
FEISHU_PARENTING_TABLE_ID=
# Optional shared Base ID alias when both channels use the same Base.
FEISHU_BASE_ID=

# Optional paid cover generation. IMAGE_ENABLED does not authorize a charge.
IMAGE_ENABLED=false
IMAGE_API_BASE=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
IMAGE_TIMEOUT_SECONDS=120
IMAGE_ALLOWED_DOWNLOAD_HOSTS=
