# 复制为 .env 后，可通过 set -a; source .env; set +a 导入当前 shell。
# 环境变量优先于 config/runtime.local.toml；即使值为空，也会覆盖本地配置。
# 暂时不用的变量请删除或注释，不要把真实 .env 和凭证提交到仓库。

# OSS AccessKey ID；执行发布上传时必填，收录和本地准备不需要。
OSS_ACCESS_KEY_ID=
# OSS AccessKey Secret；执行发布上传时必填，请作为密钥保管。
OSS_ACCESS_KEY_SECRET=
# OSS Bucket 名称；封面和文章 HTML 上传到这个存储桶。
OSS_BUCKET=kaelblog
# OSS Endpoint；设置后优先于 OSS_REGION 推导出的地址。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS 地域；仅未设置 OSS_ENDPOINT 时用于推导 Endpoint。
OSS_REGION=cn-beijing
# OSS 对象路径前缀；用于组织不同频道和文章的上传文件。
OSS_PREFIX=wechat

# 飞书交接模式；lark-cli 使用已登录用户身份发送消息并写入多维表格。
FEISHU_MODE=lark-cli
# hermes-ali-ecs 会话 ID；技术号和育儿号统一交接到此会话。
FEISHU_PRIMARY_CHAT_ID=
# 技术号飞书应用 ID；仅直接调用 Open API 的模式需要，lark-cli 模式留空即可。
FEISHU_TECH_APP_ID=
# 技术号飞书应用 Secret；仅直接调用 Open API 的模式需要，lark-cli 模式留空即可。
FEISHU_TECH_APP_SECRET=
# 育儿号飞书应用 ID；仅直接调用 Open API 的模式需要，lark-cli 模式留空即可。
FEISHU_PARENTING_APP_ID=
# 育儿号飞书应用 Secret；仅直接调用 Open API 的模式需要，lark-cli 模式留空即可。
FEISHU_PARENTING_APP_SECRET=

# 技术号交接消息的飞书会话 ID；可改用 FEISHU_PRIMARY_CHAT_ID。
FEISHU_TECH_CHAT_ID=
# 技术号飞书多维表格 Base ID；可改用 FEISHU_BASE_ID。
FEISHU_TECH_BASE_ID=
# 技术号飞书多维表格 Table ID；发布技术号文章时必填。
FEISHU_TECH_TABLE_ID=
# 育儿号交接消息的飞书会话 ID；可改用 FEISHU_PRIMARY_CHAT_ID。
FEISHU_PARENTING_CHAT_ID=
# 育儿号飞书多维表格 Base ID；可改用 FEISHU_BASE_ID。
FEISHU_PARENTING_BASE_ID=
# 育儿号飞书多维表格 Table ID；发布育儿号文章时必填。
FEISHU_PARENTING_TABLE_ID=
# 两个频道共用同一飞书 Base 时填写；频道专属 Base ID 优先。
FEISHU_BASE_ID=

# 是否启用可选的付费封面生图配置；true 不代表已授权单次调用。
IMAGE_ENABLED=false
# 图片生成 API 地址；仅在明确使用可选生图能力时需要。
IMAGE_API_BASE=https://api.openai.com/v1/images/generations
# 图片生成模型；当前实现仅支持 gpt-image-2。
IMAGE_MODEL=gpt-image-2
# 自定义URL
# OPENAI_BASE_URL=https://api.openai.com/v1
# 图片生成 API Key；仅在启用并获授权的生图调用中需要。
OPENAI_API_KEY=

# 图片生成请求超时时间，单位为秒。
IMAGE_TIMEOUT_SECONDS=120
# 允许下载图片结果的 HTTPS 主机名，多个用英文逗号分隔；Base64 返回可留空。
IMAGE_ALLOWED_DOWNLOAD_HOSTS=
